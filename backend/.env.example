# MeetingMind Backend — Environment Variables
# Copy this file to .env and adjust values as needed.

# Database
DATABASE_URL=sqlite:///./meetingmind.db

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# ── Phase 3: Optional LLM Extraction ─────────────────────────────────────────
# Leave blank to use the local rule-based extractor (no API key required).
# Set OPENAI_API_KEY to enable LLM-powered extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override for local/compatible providers (e.g. Ollama, LM Studio):
# OPENAI_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=
